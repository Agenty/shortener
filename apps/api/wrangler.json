{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shortener-api",
  "main": "index.ts",
  "workers_dev": false,
  "keep_vars": true,
  "compatibility_date": "2026-04-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "placement": { "mode": "smart" },
  "analytics_engine_datasets": [
    {
      "binding": "API_LOGS"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "78c50cb7-a076-4232-944a-d4b32ac64b8e",
      "database_name": "idm",
      "preview_database_id": "DB",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "shortener"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KVCACHE",
      "id": "cdcbd6e8e3be4a6f9f2f6e610ab43ab2"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "queues": {
    "producers": [
      {
        "binding": "QUEUE",
        "queue": "shortener-queue"
      }
    ],
    "consumers": [
      {
        "queue": "shortener-queue",
        "retry_delay": 30,
        "max_retries": 3
      }
    ]
  },
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "1041",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "PRO_RATE_LIMITER",
      "namespace_id": "1051",
      "simple": {
        "limit": 150,
        "period": 60
      }
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ]
}
