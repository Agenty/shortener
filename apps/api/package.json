{
  "name": "shortener-api",
  "version": "0.0.0",
  "description": "An open-source URL shortener to create shorten link with Cloudflare worker and pages. Deploy on Cloudflare for custom domain for free!",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check-types": "tsc --noEmit",
    "sql": "wrangler d1 execute idm --file=schema/query.sql",
    "devsql": "wrangler d1 execute idm --file=schema/query.sql --local",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "hono": "^4.13.13",
    "lodash": "^4.18.1",
    "mime": "^4.1.1",
    "nanoid": "^6.0.2",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.0.0",
    "tldts": "^7.4.18",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@types/lodash": "^4.17.26",
    "@types/react": "^19.3.0",
    "@types/ua-parser-js": "^0.7.39",
    "wrangler": "^4.151.0"
  }
}
