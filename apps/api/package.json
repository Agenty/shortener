{
  "name": "shortener.dev",
  "version": "0.0.0",
  "description": "An open-source URL shortener to create shorten link with Cloudflare worker and pages. Deploy on Cloudflare for custom domain for free!",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check-types": "tsc --noEmit",
    "sql": "wrangler d1 execute idm --file=schema/query.sql",
    "devsql": "wrangler d1 execute idm --file=schema/query.sql --local"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.16.0",
    "cheerio": "^1.0.0-rc.12",
    "dayjs": "^1.11.10",
    "hono": "^4.6.3",
    "lodash": "^4.17.21",
    "mime": "^4.0.4",
    "nanoid": "^5.0.3",
    "papaparse": "^5.4.1",
    "stripe": "^14.9.0",
    "tldts": "^6.1.50",
    "ua-parser-js": "^1.0.37",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/lodash": "^4.14.202",
    "@types/ua-parser-js": "^0.7.39",
    "wrangler": "^4.147.0"
  }
}
